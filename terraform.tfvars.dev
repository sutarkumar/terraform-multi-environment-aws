# ==============================================================================
# terraform.tfvars.dev - Development Environment Variable Values
# ==============================================================================
# CONCEPT: Environment-Specific Variable Files (.tfvars)
# Variable files allow supplying specific values for input variables per environment.
# When executing `terraform plan -var-file="terraform.tfvars.dev"`, Terraform applies
# these values to configure a lower-cost, single-instance development setup.
# ==============================================================================

project_name   = "terraform-multi-environment-aws"
environment    = "dev"
region         = "us-east-1"
instance_type  = "t3.micro"
instance_count = 1
ami_name       = "al2023-ami-2023.*-x86_64"
instance_name  = "dev-app-server"

# ==============================================================================
# terraform.tfvars.prod - Production Environment Variable Values
# ==============================================================================
# CONCEPT: Production Environment Overrides
# This file provides production-grade settings (higher instance count, larger
# instance types). Applied using `terraform plan -var-file="terraform.tfvars.prod"`.
# ==============================================================================

project_name   = "terraform-multi-environment-aws"
environment    = "prod"
region         = "us-east-1"
instance_type  = "t3.small"
instance_count = 3
ami_name       = "al2023-ami-2023.*-x86_64"
instance_name  = "prod-app-server"
